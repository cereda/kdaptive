# EditorConfig: the conventions every editor of this repository follows.
# https://editorconfig.org
#
# The build enforces the same rules: Spotless reads this file through
# ktlint, and detekt enforces the naming and documentation conventions.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
