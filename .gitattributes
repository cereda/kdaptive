# Git attributes: the repository stores text with LF endings, whatever the
# platform, and treats the binary artefacts as binary.

* text=auto eol=lf

*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.properties text eol=lf

# Build artefacts and sources of the wrapper.
gradle/wrapper/gradle-wrapper.jar binary
*.jar binary
*.zip binary
*.png binary
*.svg binary
